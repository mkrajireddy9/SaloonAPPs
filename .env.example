DATABASE_URL=postgresql://halo:halo@localhost:5432/halo
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=10mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Generate with: openssl rand -base64 24
ADMIN_INVITE_CODE=replace-with-an-admin-invite-code
# Temporary platform-admin login. Disable after bootstrapping the first salon admin.
PLATFORM_ADMIN_TEST_LOGIN=false
PLATFORM_ADMIN_EMAIL=platform.admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password
# Optional legacy admin allowlist; the current approval workflow accepts any verified Google account.
ADMIN_GOOGLE_EMAILS=
ERROR_MONITORING_WEBHOOK_URL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_PREVIEWS=true
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini
AI_ALLOW_PAID=false
AI_HAIRSTYLE_ENABLED=false
AI_DAILY_ANALYSIS_LIMIT=1
AI_DAILY_GENERATION_LIMIT=1
SEE_ON_ME_PROVIDER=local
HF_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-9B
FAL_KEY=
PAYMENT_PROVIDER=pay_at_salon
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_TAX_RATE=0
NOTIFICATION_EMAIL_WEBHOOK_URL=
# WhatsApp Cloud API notifications. Keep the access token server-side.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v27.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-random-webhook-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_APPOINTMENT_TEMPLATE=hello_world
WHATSAPP_APPOINTMENT_TEMPLATE_LANGUAGE=en_US
# Set true only when the approved template contains five body variables:
# salon name, service, date, time, stylist.
WHATSAPP_APPOINTMENT_TEMPLATE_VARIABLES=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
# Local timezone used by the 24-hour and 1-hour appointment reminder worker.
SALON_TIMEZONE=Asia/Kolkata
MEDIA_MAX_BYTES=5242880
MEDIA_RETENTION_DAYS=365
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Must be a sender/domain verified in Resend, e.g. Halo Salon <noreply@yourdomain.com>
EMAIL_FROM=Halo Salon <noreply@yourdomain.com>
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Optional comma-separated web, Android, and iOS Google OAuth client IDs.
GOOGLE_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com
# Twilio Verify SMS login
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Temporary testing only; remove/disable before production use.
SMS_FIXED_OTP_ENABLED=false
SMS_FIXED_OTP=123456
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
EMAIL_REMINDERS_ENABLED=true
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
